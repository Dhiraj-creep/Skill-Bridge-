# Skill Bridge — Environment Configuration Template
# Copy this file to .env for local overrides if needed.

# Backend Server Configuration
PORT=3001
NODE_ENV=development

# Database Path (defaults to server/database/cep_portal.sqlite)
# DB_PATH=./server/database/cep_portal.sqlite

# Demo Seeding Control
# Set to 'false' in production to start with a clean database without sample users or records.
# Defaults to true in development, false in production.
# SEED_DEMO_ACCOUNTS=false

# CORS & Allowed Origins
# CLIENT_URL=http://localhost:5174
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://yourdomain.edu

# Reverse Proxy & Cookie Security for Production Deployments
# TRUST_PROXY=true (Set to true if behind Nginx / Cloudflare / reverse proxy)
# COOKIE_SECURE=true (Set to true to force HTTPS-only Secure session cookies in production)

# Session Security (Optional custom secret for signing, defaults to built-in cryptographic tokens)
SESSION_SECRET=skillbridge_local_development_secure_key_change_in_production

# Frontend Presentation Settings
# Set to 'true' to display 1-click demo login buttons on the login screen during development/evaluation.
# Defaults to 'false' (clean production-style credential inputs).
VITE_ENABLE_DEMO_SHORTCUTS=false

# Initial Administrator Provisioning (Optional environment variables for automated deployment scripts)
# ADMIN_USER=admin
# ADMIN_PASS=YourStrongProductionPassword123!
